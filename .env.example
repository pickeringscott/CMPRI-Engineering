# CMPRI - Engineering v1.0
# Non-secret deployment checklist. Fill these in the deployment environment;
# never commit production values or copy credentials into client-side code.

# Supabase browser/session configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public production URL used in password-reset emails, for example https://cmpri.example.com
NEXT_PUBLIC_APP_URL=

# Supabase server-only administration
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Web Push VAPID credentials. Generate with `npx web-push generate-vapid-keys`.
# The public key is returned only to eligible signed-in users; never expose the private key.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# Server-only AES-256 key used to encrypt per-user OpenAI credentials. Generate
# 32 random bytes and store the 64-character hex value in Vercel, never here.
CMPRI_AI_CREDENTIAL_ENCRYPTION_KEY=

# Server-only Google service account shared with the private Room Ranker and Corporate PM sheets
CMPRI_GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
# Alternatively, supply the two service-account fields separately:
CMPRI_GOOGLE_SHEETS_CLIENT_EMAIL=
CMPRI_GOOGLE_SHEETS_PRIVATE_KEY=
CMPRI_ROOM_RANKER_SPREADSHEET_ID=
CMPRI_ROOM_RANKER_SHEET_NAME=
CMPRI_CORPORATE_PM_SPREADSHEET_ID=
CMPRI_LIVE_PM_SPREADSHEET_ID=1_U-BYk9wUI9kyxglw3_5hs3-zWoBjW7WE52HJDtJKYs
# Keep false during dev preview. Even when true, sheet edits require reviewer approval.
CMPRI_LIVE_PM_WRITES_ENABLED=false

# Integrations safe mode. When unset or "true", writes to Room Ranker and
# Corporate PM are blocked at the server (reads still work) so testing
# credentials never affect corporate. Set to "false" only at go-live.
CMPRI_INTEGRATIONS_SAFE_MODE=true

# Email provider selection: microsoft or gmail
CMPRI_EMAIL_PROVIDER=

# Microsoft 365 / Graph mailbox reader
CMPRI_MS_TENANT_ID=
CMPRI_MS_CLIENT_ID=
CMPRI_MS_CLIENT_SECRET=
CMPRI_MS_MAILBOX=

# Gmail mailbox reader (only if Gmail is selected/configured)
CMPRI_GMAIL_CLIENT_ID=
CMPRI_GMAIL_CLIENT_SECRET=
CMPRI_GMAIL_REFRESH_TOKEN=
CMPRI_GMAIL_USER=
CMPRI_GMAIL_ADDRESS=
CMPRI_GMAIL_QUERY=

# Protect scheduled server-to-server integration jobs
CRON_SECRET=

# Dedicated database notification webhook credential; set only in secure deployment configuration.
CMPRI_NOTIFICATION_WEBHOOK_SECRET=
