# CMPRI - Engineering v1.0
# Non-secret deployment checklist. Fill these in the deployment environment;
# never commit production values or copy credentials into client-side code.

# Supabase browser/session configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public production URL used in password-reset emails, for example https://cmpri.example.com
NEXT_PUBLIC_APP_URL=

# Supabase server-only administration
SUPABASE_SERVICE_ROLE_KEY=

# Explicit manual "Refresh AI" action only
OPENAI_API_KEY=

# Corporate Room Ranker Google Apps Script adapter
CMPRI_ROOM_RANKER_API_URL=
CMPRI_ROOM_RANKER_API_KEY=

# Corporate PM Google Apps Script adapter
CMPRI_CORPORATE_PM_API_URL=
CMPRI_CORPORATE_PM_API_KEY=

# Integrations safe mode. When unset or "true", writes to Room Ranker and
# Corporate PM are blocked at the server (reads still work) so testing
# credentials never affect corporate. Set to "false" only at go-live.
CMPRI_INTEGRATIONS_SAFE_MODE=true

# Email provider selection: microsoft or gmail
CMPRI_EMAIL_PROVIDER=

# Microsoft 365 / Graph mailbox reader
CMPRI_MS_TENANT_ID=
CMPRI_MS_CLIENT_ID=
CMPRI_MS_CLIENT_SECRET=
CMPRI_MS_MAILBOX=

# Gmail mailbox reader (only if Gmail is selected/configured)
CMPRI_GMAIL_CLIENT_ID=
CMPRI_GMAIL_CLIENT_SECRET=
CMPRI_GMAIL_REFRESH_TOKEN=
CMPRI_GMAIL_USER=
CMPRI_GMAIL_ADDRESS=
CMPRI_GMAIL_QUERY=

# Protect scheduled server-to-server integration jobs
CRON_SECRET=
